      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Create a dictionary of model's performance\n",
        "performance_summary = {\n",
        "    \"Model Type\": \"Decision Tree Classifier (Baseline)\",\n",
        "    \"Accuracy\": f\"{acc:.4f}\",\n",
        "    \"F1-Score\": f\"{f1:.4f}\",\n",
        "    \"ROC-AUC\": f\"{roc:.4f}\",\n",
        "    \"RMSE\": f\"{rmse:.4f}\"\n",
        "}"
      ],
